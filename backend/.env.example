# API port (optional, defaults to 3000)
PORT=3000

# Interface to listen on (optional, defaults to 127.0.0.1 = this machine only).
# Use 0.0.0.0 only when a phone/emulator on your network or a host must reach the API.
HOST=127.0.0.1

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spoileralert

# Long random string used to sign JWTs (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-string

# Token lifetime (optional, defaults to 7d)
JWT_EXPIRES_IN=7d

# OMDb API key (free at omdbapi.com)
OMDB_API_KEY=your-omdb-key

# Comma-separated allowed origins, no spaces needed, no trailing slashes
CORS_ORIGIN=http://localhost:8100,http://localhost

# Optional: DNS servers for Node, comma-separated. Only needed if the MongoDB
# connection fails with "querySrv ETIMEOUT" (Node can't read the system DNS).
DNS_SERVERS=1.1.1.1

# Optional: password shared by the demo users created with "pnpm seed:demo" (8-72 characters, no spaces).
DEMO_USER_PASSWORD=choose-a-demo-password
