        {
          "name": "sort=audience: highest first, unscored last",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const values = pm.response.json().data.map((program) => program.pointsMeanNormal);",
            "const firstNull = values.indexOf(null);",
            "const scored = firstNull === -1 ? values : values.slice(0, firstNull);",
            "pm.test('scored titles: highest first', () => pm.expect(scored).to.eql([...scored].sort((a, b) => b - a)));",
            "pm.test('titles without score come last', () => pm.expect(firstNull === -1 || values.slice(firstNull).every((value) => value === null)).to.eql(true));"
          ] } }],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenNormal}}", "type": "string" }] },
            "url": "{{baseUrl}}/programs?type=movie&sort=audience&limit=50"
          }
