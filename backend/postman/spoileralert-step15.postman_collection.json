            "const data = pm.response.json().data;",
            "pm.test('the movie is in the results', () => pm.expect(data.map((program) => program._id)).to.include(pm.variables.get('programId')));",
            "pm.test('every result has pointsMeanNormal >= 80', () => data.forEach((program) => pm.expect(program.pointsMeanNormal).to.be.at.least(80)));"
          ] } }],
          "request": {
